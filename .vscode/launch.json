{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hydra",
      "type": "debugpy",
      "request": "launch",
      "module": "hydra",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Hydra diagnostics",
      "type": "debugpy",
      "request": "launch",
      "module": "hydra",
      "args": ["--diagnostics"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
